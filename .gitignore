# herdr runtime artifacts (regenerated at runtime; never commit)
home/.config/herdr/**/*.log
home/.config/herdr/session.json
home/.config/herdr/**/*.sock
home/.config/herdr/.plugins.lock
# herdr plugins are installed by home.nix activation, not committed
home/.config/herdr/plugins/
home/.config/herdr/plugins.json

# Karabiner writes timestamped backups next to karabiner.json
home/.config/karabiner/automatic_backups/

# local secrets, macOS + nix build noise
.env
.DS_Store
result
result-*

# Pi credentials and Home Manager adoption backups stay local
/home/.pi/agent/auth.json
/home/.pi/agent/**/*.backup

# Pi Calm is a runtime toggle; its local state file is never tracked
/home/.pi/agent/calm

# TerminalGraph.app installs its own unlicensed Pi integration here; keep vendor code out of the public repo
/home/.pi/agent/extensions/terminalgraph/

# no-mistakes local validation state - never commit in this public repo
.no-mistakes/

# agent tooling local state - never commit
/.claude/
/.recall/
/.serena/

# editor swap files
*.swp
